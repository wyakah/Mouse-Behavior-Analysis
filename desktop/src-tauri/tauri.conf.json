{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Behavior Studio",
  "version": "0.1.3",
  "identifier": "com.wyakah.behaviorstudio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "startup",
        "title": "Behavior Studio",
        "width": 650,
        "height": 440,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "../bundle/": "bundle/"
    },
    "category": "Education",
    "shortDescription": "Local mouse behavior analysis",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
